{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nom affich\u00e9"
    },
    "initials": {
      "type": "string",
      "title": "Initiales (logo)"
    },
    "role": {
      "type": "string",
      "title": "Intitul\u00e9 du poste"
    },
    "tagline": {
      "type": "string",
      "title": "Accroche"
    },
    "intro": {
      "type": "string",
      "title": "Pr\u00e9sentation"
    },
    "location": {
      "type": "string",
      "title": "Localisation"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "linkedin": {
      "type": "string",
      "title": "Profil LinkedIn"
    },
    "cv_url": {
      "type": "string",
      "title": "CV (PDF)"
    }
  },
  "rls": {
    "read": {},
