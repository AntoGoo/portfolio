{
  "name": "Project",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Titre"
    },
    "year": {
      "type": "string",
      "title": "Cat\u00e9gorie"
    },
    "context": {
      "type": "string",
      "title": "Contexte"
    },
    "problem": {
      "type": "string",
      "title": "Probl\u00e9matique"
    },
    "objectives": {
      "type": "string",
      "title": "Objectifs"
    },
    "role": {
      "type": "string",
      "title": "R\u00f4le et responsabilit\u00e9s"
    },
    "methodology": {
      "type": "string",
      "title": "M\u00e9thodologie"
    },
    "solutions": {
      "type": "string",
      "title": "Solutions mises en \u0153uvre"
    },
    "results": {
      "type": "string",
      "title": "R\u00e9sultats"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mots-cl\u00e9s"
    },
    "link": {
      "type": "string",
      "title": "Lien du projet"
    },
    "link_label": {
      "type": "string",
      "title": "Libell\u00e9 du lien"
    },
    "logo_url": {
      "type": "string",
      "title": "Logo"
    },
    "image_url": {
      "type": "string",
      "title": "Image"
    },
    "published": {
      "type": "boolean",
      "default": true,
      "title": "Publi\u00e9"
    },
    "order": {
      "type": "number",
      "title": "Ordre d'affichage"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}